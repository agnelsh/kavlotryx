# syntax=docker/dockerfile:1
# Public read-only demo image: the sample data is seeded at build time, so a
# start only copies one SQLite file. Build from the repository root:
#   docker build -f deploy/Dockerfile.demo -t kavlotryx-demo .
# Deployed on Cloudflare Containers by deploy/cloudflare (see its README).

FROM python:3.13-slim AS build
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

# Seed: download the public scanner samples (pinned commit, SHA-256 checked) and run
# the three-day sample story, including the DefectDojo export and triage decisions.
FROM python:3.13-slim AS seed
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /install /usr/local
WORKDIR /seed
COPY examples ./examples
COPY hack ./hack
RUN KAVLO=kavlo PYTHON=python hack/demo-samples.sh > /seed/seed.log 2>&1 || (tail -40 /seed/seed.log && exit 1)

FROM python:3.13-slim
RUN useradd --uid 10001 --create-home kavlo
COPY --from=build /install /usr/local
COPY --from=seed /seed/.kavlotryx/samples.db /opt/kavlotryx/demo.db
COPY --from=seed /seed/.kavlotryx/samples-tracker.json /opt/kavlotryx/tracker.json
COPY --from=seed /seed/examples/samples/defectdojo/NOTICE.md /opt/kavlotryx/THIRD-PARTY-SAMPLES.md
COPY examples/samples/config /etc/kavlotryx
COPY deploy/demo-entrypoint.sh /usr/local/bin/kavlo-demo
ENV KAVLO_CONFIG_DIR=/etc/kavlotryx \
    KAVLO_DEMO_MODE=1 \
    KAVLO_DATABASE_URL=sqlite:////tmp/kavlotryx/demo.db \
    KAVLO_TRACKER=fake \
    KAVLO_FAKE_TRACKER_FILE=/tmp/kavlotryx/tracker.json \
    KAVLO_GRAPH_SNAPSHOT=/etc/kavlotryx/graph-snapshot.json \
    KAVLO_LEANIX_SNAPSHOT=/etc/kavlotryx/leanix-snapshot.json \
    KAVLO_AUTO_MIGRATE=1 \
    PYTHONUNBUFFERED=1
USER 10001
WORKDIR /home/kavlo
EXPOSE 8080
ENTRYPOINT ["kavlo-demo"]
