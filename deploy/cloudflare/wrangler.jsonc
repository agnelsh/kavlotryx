{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kavlotryx-demo",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"upload_source_maps": true,
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "KavlotryxDemo",
			"image": "../Dockerfile.demo",
			"image_build_context": "../..",
			"instance_type": "basic", // 1/4 vCPU, 1 GiB memory, 4 GB disk
			"max_instances": 1 // one shared demo; also caps the cost
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "DEMO", "class_name": "KavlotryxDemo" }]
	},
	"exports": {
		"KavlotryxDemo": { "type": "durable-object", "storage": "sqlite" }
	},
	"vars": {
		// Set to your custom domain once it is attached, e.g. "https://kavlotryx-demo.example.com".
		// Empty: the demo uses the address of the request that woke it.
		"PUBLIC_URL": ""
	}
	// To serve the demo on your own domain (its DNS must be on Cloudflare), uncomment:
	// ,"routes": [{ "pattern": "kavlotryx-demo.example.com", "custom_domain": true }]
}
